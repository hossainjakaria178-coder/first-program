#include <stdio.h>
int main() {
    char str1[50], str2[50]; int flag = 0;
    printf("Enter str1: "); scanf("%s", str1);
    printf("Enter str2: "); scanf("%s", str2);
    for (int i = 0; str1[i] != '\0' || str2[i] != '\0'; i++) {
        if (str1[i] != str2[i]) { flag = 1; break; }
    }
    if (flag == 0) printf("Equal\n");
    else printf("Not Equal\n");
    return 0;
}
