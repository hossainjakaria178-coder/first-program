#include <stdio.h>
#include <ctype.h>

int main() {
    char str[200];
    int present[26] = {0}, count = 0;
    printf("Enter string: ");
    fgets(str, sizeof(str), stdin);
    for (int i = 0; str[i] != '\0'; i++) {
        if (isalpha(str[i])) {
            int index = tolower(str[i]) - 'a';
            if (!present[index]) { present[index] = 1; count++; }
        }
    }
    if (count == 26) printf("Pangram\n");
    else printf("Not a Pangram\n");
    return 0;
}
