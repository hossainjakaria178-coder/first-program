#include <stdio.h>
#include <math.h>

int octToDec(int oct) {
    int dec = 0, i = 0;
    while (oct != 0) {
        dec += (oct % 10) * pow(8, i);
        ++i; oct /= 10;
    }
    return dec;
}

int main() {
    int oct;
    printf("Enter an octal number: ");
    scanf("%d", &oct);
    printf("Decimal: %d\n", octToDec(oct));
    return 0;
}
