#include <stdio.h>
int main() {
    int num, sq, temp, flag = 1;
    printf("Enter a number: ");
    scanf("%d", &num);
    sq = num * num;
    temp = num;
    while (temp > 0) {
        if (temp % 10 != sq % 10) { flag = 0; break; }
        temp /= 10; sq /= 10;
    }
    if (flag) printf("%d is an Automorphic Number\n", num);
    else printf("%d is not an Automorphic Number\n", num);
    return 0;
}
