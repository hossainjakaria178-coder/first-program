#include <stdio.h>
#include <math.h>

int checkPrime(int n) {
    if (n <= 1) return 0;
    for (int i = 2; i <= n / 2; ++i) if (n % i == 0) return 0;
    return 1;
}

int checkArmstrong(int n) {
    int temp = n, sum = 0, digits = 0, rem;
    while (temp != 0) { temp /= 10; ++digits; }
    temp = n;
    while (temp != 0) { rem = temp % 10; sum += pow(rem, digits); temp /= 10; }
    return (sum == n);
}

int main() {
    int n;
    printf("Enter a number: ");
    scanf("%d", &n);
    if (checkPrime(n)) printf("%d is Prime.\n", n);
    if (checkArmstrong(n)) printf("%d is Armstrong.\n", n);
    return 0;
}
