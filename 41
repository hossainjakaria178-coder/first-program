#include <stdio.h>
#include <math.h>

int binToOct(long long bin) {
    int dec = 0, oct = 0, i = 0;
    while (bin != 0) {
        dec += (bin % 10) * pow(2, i); ++i; bin /= 10;
    }
    i = 1;
    while (dec != 0) {
        oct += (dec % 8) * i; dec /= 8; i *= 10;
    }
    return oct;
}

int main() {
    long long bin;
    printf("Enter binary: ");
    scanf("%lld", &bin);
    printf("Octal: %d\n", binToOct(bin));
    return 0;
}
