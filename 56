#include <stdio.h>
int main() {
    int arr[100], n, max1, max2;
    printf("Enter size: ");
    scanf("%d", &n);
    for (int i = 0; i < n; i++) scanf("%d", &arr[i]);
    max1 = max2 = -999999;
    for (int i = 0; i < n; i++) {
        if (arr[i] > max1) { max2 = max1; max1 = arr[i]; }
        else if (arr[i] > max2 && arr[i] < max1) { max2 = arr[i]; }
    }
    printf("Second largest = %d\n", max2);
    return 0;
}
