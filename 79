#include <stdio.h>
#include <string.h>
int main() {
    char str1[50], str2[50];
    printf("Enter str1 and str2: ");
    scanf("%s %s", str1, str2);
    int res = strcmp(str1, str2);
    if (res == 0) printf("Strings are equal.\n");
    else if (res < 0) printf("%s comes before %s\n", str1, str2);
    else printf("%s comes after %s\n", str1, str2);
    return 0;
}
