#include <stdio.h>

struct Student {
    char name[50];
    int roll;
    float marks;
};

int main() {
    struct Student s[3];
    for (int i = 0; i < 3; i++) {
        printf("Enter info for Student %d (Name Roll Marks): ", i + 1);
        scanf("%s %d %f", s[i].name, &s[i].roll, &s[i].marks);
    }
    for (int i = 0; i < 3; i++) {
        printf("Student %d: %s, Roll: %d, Marks: %.2f\n", i + 1, s[i].name, s[i].roll, s[i].marks);
    }
    return 0;
}
