#include <stdio.h>
int main() {
    char str[200]; int count = 0;
    printf("Enter string: ");
    fgets(str, sizeof(str), stdin);
    for (int i = 0; str[i] != '\0'; i++) {
        if (str[i] == ' ' || str[i] == '\n' || str[i] == '\t') count++;
    }
    printf("Total words: %d\n", count);
    return 0;
}
