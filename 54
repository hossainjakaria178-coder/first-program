#include <stdio.h>
int main() {
    int n; float arr[100], sum = 0.0;
    printf("Enter number of elements: ");
    scanf("%d", &n);
    for (int i = 0; i < n; ++i) {
        printf("Enter number %d: ", i + 1);
        scanf("%f", &arr[i]);
        sum += arr[i];
    }
    printf("Average = %.2f\n", sum / n);
    return 0;
}
