#include <stdio.h>
int checkPrime(int n) {
    if (n <= 1) return 0;
    for (int i = 2; i <= n / 2; ++i) {
        if (n % i == 0) return 0;
    }
    return 1;
}
int main() {
    int n1, n2;
    printf("Enter intervals: ");
    scanf("%d %d", &n1, &n2);
    for (int i = n1 + 1; i < n2; ++i) {
        if (checkPrime(i)) printf("%d ", i);
    }
    printf("\n");
    return 0;
}
