#include <stdio.h>
void multiplyMatrices(int first[10][10], int second[10][10], int result[10][10], int r, int c) {
    for (int i = 0; i < r; ++i) {
        for (int j = 0; j < c; ++j) {
            result[i][j] = 0;
            for (int k = 0; k < c; ++k) result[i][j] += first[i][k] * second[k][j];
        }
    }
}
int main() {
    int a[10][10], b[10][10], res[10][10], r, c;
    printf("Enter r and c: ");
    scanf("%d %d", &r, &c);
    for (int i = 0; i < r; ++i) for (int j = 0; j < c; ++j) scanf("%d", &a[i][j]);
    for (int i = 0; i < r; ++i) for (int j = 0; j < c; ++j) scanf("%d", &b[i][j]);
    multiplyMatrices(a, b, res, r, c);
    for (int i = 0; i < r; ++i) {
        for (int j = 0; j < c; ++j) printf("%d ", res[i][j]);
        printf("\n");
    }
    return 0;
}
