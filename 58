#include <stdio.h>
#include <math.h>
int main() {
    float data[10], sum = 0.0, mean, SD = 0.0;
    printf("Enter 10 elements: ");
    for (int i = 0; i < 10; ++i) { scanf("%f", &data[i]); sum += data[i]; }
    mean = sum / 10;
    for (int i = 0; i < 10; ++i) SD += pow(data[i] - mean, 2);
    printf("Standard Deviation = %.6f\n", sqrt(SD / 10));
    return 0;
}
