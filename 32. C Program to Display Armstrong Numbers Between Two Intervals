#include <stdio.h>
#include <math.h>
int main() {
    int low, high;
    printf("Enter two numbers: ");
    scanf("%d %d", &low, &high);
    printf("Armstrong numbers: ");
    for (int i = low + 1; i < high; ++i) {
        int temp1 = i, temp2 = i, n = 0, result = 0, rem;
        while (temp1 != 0) { temp1 /= 10; ++n; }
        while (temp2 != 0) { rem = temp2 % 10; result += pow(rem, n); temp2 /= 10; }
        if (result == i) printf("%d ", i);
    }
    printf("\n");
    return 0;
}
