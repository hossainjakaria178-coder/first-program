#include <stdio.h>

struct TIME {
    int seconds, minutes, hours;
};

int main() {
    struct TIME t1, t2, diff;
    printf("Enter start time (h m s): ");
    scanf("%d %d %d", &t1.hours, &t1.minutes, &t1.seconds);
    printf("Enter stop time (h m s): ");
    scanf("%d %d %d", &t2.hours, &t2.minutes, &t2.seconds);
    if (t2.seconds > t1.seconds) { --t1.minutes; t1.seconds += 60; }
    diff.seconds = t1.seconds - t2.seconds;
    if (t2.minutes > t1.minutes) { --t1.hours; t1.minutes += 60; }
    diff.minutes = t1.minutes - t2.minutes;
    diff.hours = t1.hours - t2.hours;
    printf("Difference: %d:%d:%d\n", diff.hours, diff.minutes, diff.seconds);
    return 0;
}
