#include <stdio.h>
int main() {
    char line[150];
    int v = 0, c = 0, d = 0, s = 0;
    printf("Enter a line of string: ");
    fgets(line, sizeof(line), stdin);
    for (int i = 0; line[i] != '\0'; ++i) {
        if (line[i]=='a'||line[i]=='e'||line[i]=='i'||line[i]=='o'||line[i]=='u'||
            line[i]=='A'||line[i]=='E'||line[i]=='I'||line[i]=='O'||line[i]=='U') ++v;
        else if ((line[i]>='a'&&line[i]<='z')||(line[i]>='A'&&line[i]<='Z')) ++c;
        else if (line[i]>='0' && line[i]<='9') ++d;
        else if (line[i]==' ') ++s;
    }
    printf("Vowels: %d\nConsonants: %d\nDigits: %d\nSpaces: %d\n", v, c, d, s);
    return 0;
}
