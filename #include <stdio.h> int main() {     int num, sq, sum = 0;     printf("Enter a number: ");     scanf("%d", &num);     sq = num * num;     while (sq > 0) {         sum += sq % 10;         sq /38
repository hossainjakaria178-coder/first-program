#include <stdio.h>
int main() {
    int num, sq, sum = 0;
    printf("Enter a number: ");
    scanf("%d", &num);
    sq = num * num;
    while (sq > 0) {
        sum += sq % 10;
        sq /= 10;
    }
    if (sum == num) printf("%d is a Neon Number\n", num);
    else printf("%d is not a Neon Number\n", num);
    return 0;
}
